# Copy to .env.local and fill in real values. .env.local is gitignored and
# never committed — this file only documents which variables exist.

# Gmail account that /api/enquiry sends through. GMAIL_APP_PASSWORD is a Gmail
# "App Password" (Google Account → Security → 2-Step Verification → App
# passwords), not the account's login password — Gmail's SMTP won't accept a
# plain password from a script.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Production origin. See src/config/site.ts.
NEXT_PUBLIC_SITE_URL=
